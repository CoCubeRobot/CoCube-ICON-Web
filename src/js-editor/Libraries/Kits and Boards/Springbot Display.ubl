module 'Springbot Display' Output
author bjarke@gotfredsen.com
version 1 0 
depends Springbot 
description 'Draw monochrome graphics and write text on boards with a TFT/OLED display'

  spec ' ' '[tft:clear]' 'clear display'
  space
  spec ' ' 'tft:rect' 'draw rectangle at x _ y _ width _ height _ inverted _ : filled _' 'num num num num bool bool' 10 10 40 30 false true
  spec ' ' 'tft:roundedRect' 'draw rounded rectangle at x _ y _ width _ height _ radius _ inverted _ : filled _' 'num num num num num bool bool' 10 10 40 30 8 false true
  spec ' ' 'tft:circle' 'draw circle at x _ y _ radius _ inverted _ : filled _' 'num num num bool bool' 40 40 30 false true
  spec ' ' 'tft:triangle' 'draw triangle at x _ y _ , x _ y _ , x _ y _ inverted _ : filled _' 'num num num num num num bool bool' 20 20 30 80 60 5 false true
  spec ' ' 'tft:line' 'draw line from x _ y _ to x _ y _ inverted _' 'num num num num bool' 12 8 25 15 false
  spec ' ' 'tft_drawVector' 'draw vector x _ y _ angle _ length _ inverted _' 'num num num num bool' 40 40 45 40 false
  space
  spec ' ' 'tft:text' 'write _ at x _ y _ inverted _ : scale _ wrap _ : bg inverted _' 'str num num bool num bool bool' 'Hello World!' 5 5 false 2 true true
  spec ' ' 'tft_drawText' 'draw text _ at x _ y _ inverted _ : scale _ : bg inverted _' 'str num num bool num bool' 'Line 1
Line 2' 50 20 false 2 true
  space
  spec ' ' 'tft:setPixel' 'set pixel x _ y _ to inverted _' 'num num bool' 10 10 false
  spec ' ' '[tft:pixelRow]' 'draw pixel row _ x _ y _ : bytesPerPixel _ : palette _' 'auto num num num str' 'aList' 0 0 4
  spec ' ' '[tft:drawBitmap]' 'draw bitmap _ palette _ at x _ y _' 'str str num num' 'aBitmap' 'a list of colors' 10 10
  space
  spec 'r' 'black' 'black'
  spec 'r' 'white' 'white'
  space
  spec 'r' '[tft:getWidth]' 'display width'
  spec 'r' '[tft:getHeight]' 'display height'
  space
  spec ' ' '[tft:setBacklight]' 'set display backlight _ (0-10)' 'num' 10
  space
  spec ' ' '_deferMonochromeDisplayUpdates' '_defer monochrome display updates'
  spec ' ' '_resumeMonochromeDisplayUpdates' '_resume monochrome display updates'

to '_deferMonochromeDisplayUpdates' {
  '[tft:deferUpdates]'
}

to '_resumeMonochromeDisplayUpdates' {
  '[tft:resumeUpdates]'
}

to black {
  return 0
}

to 'tft:circle' x y radius inverted filled {
  '[tft:circle]' x y radius (tft__bwColor inverted) filled
}

to 'tft:line' x1 y1 x2 y2 inverted {
  '[tft:line]' x1 y1 x2 y2 (tft__bwColor inverted)
}

to 'tft:rect' x y w h inverted filled {
  '[tft:rect]' x y w h (tft__bwColor inverted) filled
}

to 'tft:roundedRect' x y w h radius inverted filled {
  '[tft:roundedRect]' x y w h radius (tft__bwColor inverted) filled
}

to 'tft:setPixel' x y inverted {
  '[tft:setPixel]' x y (tft__bwColor inverted)
}

to 'tft:text' s x y inverted optionalScale wrap optionalBGInverted {
  s = ('[data:convertType]' s 'string')
  local 'scale' (argOrDefault 5 2)
  local 'bgInverted' (argOrDefault 7 true)
  local 'fg' (tft__bwColor inverted)
  local 'bg' (tft__bwColor bgInverted)
  '[tft:text]' s x y fg scale wrap bg
}

to 'tft:triangle' x1 y1 x2 y2 x3 y3 inverted filled {
  '[tft:triangle]' x1 y1 x2 y2 x3 y3 (tft__bwColor inverted) filled
}

to tft__bwColor inverted {
  if inverted {
    return (black)
  } else {
    return (white)
  }
}

to tft_drawText s x y inverted optionalScale optionalBGInverted {
  s = ('[data:convertType]' s 'string')
  local 'scale' (argOrDefault 5 2)
  local 'bgInverted' (argOrDefault 6 true)
  local 'fg' (tft__bwColor inverted)
  local 'bg' (tft__bwColor bgInverted)
  for line ('[data:split]' s ('[data:unicodeString]' 10)) {
    '[tft:text]' line x y fg scale false bg
    y += (8 * scale)
  }
}

to tft_drawVector x y angle length inverted {
  local 'endX' (x + ((length * ('[misc:sin]' (100 * (angle + 90)))) >> 14))
  local 'endY' (y + ((length * ('[misc:sin]' (100 * angle))) >> 14))
  'tft:line' x y endX endY inverted
}

to white {
  return 16777215
}

