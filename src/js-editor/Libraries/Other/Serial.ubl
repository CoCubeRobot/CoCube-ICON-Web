module Serial Input
author MicroBlocks
version 1 0 
description 'Buffered serial operations.

Reads fixed-size data chunks from the serial port, storing any leftover bytes in a buffer for later read operations. Includes operations to read integers of various sizes.
Writes arbitrarily long strings or byte arrays using multiple calls if necessary.

Assumes the serial port has been opened at the desired baud rate.
'
variables _serial_read_buffer 

  spec 'r' 'serial_available' 'serial bytes available'
  spec 'r' 'serial_next' 'read _ bytes : as string _' 'num bool' 10 false
  space
  spec ' ' 'serial_skip' 'skip _ bytes' 'num' 10
  spec ' ' 'serial_clear' 'clear serial input'
  space
  spec 'r' 'serial_8bit' 'read 8-bit number signed _' 'bool' false
  spec 'r' 'serial_16bit' 'read 16-bit number MSB _ signed _' 'bool bool' false false
  spec 'r' 'serial_24bit' 'read 24-bit number MSB _ signed _' 'bool bool' false false
  spec 'r' 'serial_32bit' 'read 32-bit number MSB _' 'bool' false
  space
  spec ' ' 'serial_writeAll' 'serial write all _' 'str' 'ABC'

to serial_16bit msb signed {
  local 'bytes' (serial_next 2)
  if msb {
    local 'result' (((at 1 bytes) << 8) | (at 2 bytes))
  } else {
    local 'result' (((at 2 bytes) << 8) | (at 1 bytes))
  }
  if signed {
    comment 'Sign-extend the result'
    result = ((result << 15) >> 15)
  }
  return result
}

to serial_24bit msb signed {
  local 'bytes' (serial_next 3)
  if msb {
    local 'result' (((at 1 bytes) << 16) | (((at 2 bytes) << 8) | (at 3 bytes)))
  } else {
    local 'result' (((at 3 bytes) << 16) | (((at 2 bytes) << 8) | (at 1 bytes)))
  }
  if signed {
    comment 'Sign-extend the result'
    result = ((result << 7) >> 7)
  }
  return result
}

to serial_32bit msb {
  local 'bytes' (serial_next 4)
  if msb {
    local 'high byte' (at 1 bytes)
    local 'result' ((((at 1 bytes) << 24) | ((at 2 bytes) << 16)) | (((at 3 bytes) << 8) | (at 4 bytes)))
  } else {
    local 'high byte' (at 4 bytes)
    local 'result' ((((at 4 bytes) << 24) | ((at 3 bytes) << 16)) | (((at 2 bytes) << 8) | (at 1 bytes)))
  }
  if ((v 'high byte') > 127) {
    sayIt '32-bit number is out of range for MicroBlocks'
    stopTask
  }
  return result
}

to serial_8bit signed {
  repeatUntil ((serial_available) > 0) {
    waitMillis 1
  }
  local 'result' (at 1 _serial_read_buffer)
  _serial_read_buffer = ('[data:copyFromTo]' _serial_read_buffer 2)
  if signed {
    comment 'Sign-extend the result'
    result = ((result << 23) >> 23)
  }
  return result
}

to serial_available {
  comment 'Return the number of bytes available for reading.'
  if (_serial_read_buffer == 0) {
    _serial_read_buffer = ('[data:newByteArray]' 0)
  }
  local 'newData' ('[serial:read]')
  if ((size newData) != 0) {
    _serial_read_buffer = ('[data:join]' _serial_read_buffer newData)
  }
  return (size _serial_read_buffer)
}

to serial_clear {
  _serial_read_buffer = ('[data:newByteArray]' 0)
}

to serial_next byteCount optionalStringFlag {
  comment 'Wait until byteCount bytes have been received, then return them
as a byte array or, with the optional flag, as a string.'
  repeatUntil ((serial_available) >= byteCount) {
    waitMillis 1
  }
  local 'result' ('[data:copyFromTo]' _serial_read_buffer 1 byteCount)
  _serial_read_buffer = ('[data:copyFromTo]' _serial_read_buffer (byteCount + 1))
  if (argOrDefault 2 false) {
    result = ('[data:convertType]' result 'string')
  }
  return result
}

to serial_skip byteCount {
  local 'ignore' (serial_next byteCount false)
}

to serial_writeAll data {
  comment 'Write the given byte array or string using multiple write operations if necessary.'
  data = ('[data:convertType]' data 'byte array')
  repeatUntil ((size data) == 0) {
    local 'bytesWritten' ('[serial:writeBytes]' data 1)
    if (bytesWritten > 0) {
      if (bytesWritten == (size data)) {
        return 0
      } else {
        data = ('[data:copyFromTo]' data (bytesWritten + 1))
        waitMillis 10
      }
    }
  }
}

