module 'Color & Proximity (APDS9151)' Input
author MicroBlocks
version 1 3 
choices apds9151_exposure '25' '50' '100' '200' '400' 
choices apds9151_gain '1' '3' '6' '9' '18' 
description 'Color, light (RGB and IR) and proximity sensor library (I2C addr: 0x52).

https://docs.broadcom.com/doc/APDS-9151-DS
'
variables _apds9151Addr apds9151_gain apds9151_shift 

  spec 'r' 'apds9151_lightLevel' 'apds9151 light level'
  space
  spec 'r' 'apds9151_color' 'apds9151 color'
  spec 'r' 'apds9151_hue' 'apds9151 hue'
  spec 'r' 'apds9151_seesColor' 'apds9151 sees color _ : threshold _' 'color num' nil 30
  space
  spec 'r' 'apds9151_isClose' 'apds9151 object close?'
  spec 'r' 'apds9151_proximity' 'apds9151 proximity'
  advanced
  spec ' ' 'apds9151_setGainAndExposure' 'apds9151 set gain _ exposure time _ msecs' 'menu.apds9151_gain menu.apds9151_exposure' 9 25
  spec 'r' 'apds9151_IR' 'apds9151 IR'
  space
  spec ' ' '_apds9151_init' '_apds9151_init'
  spec 'r' '_apds9151_readData' '_apds9151_readData'
  spec 'r' '_apds9151_twentyBits' '_apds9151_twentyBits _ _ _' 'auto auto auto' 0 0 0

to '_apds9151_init' {
  if (_apds9151Addr != 0) {
    comment 'Already initialized'
    return 0
  }
  _apds9151Addr = (hexToInt '52')
  comment 'Set 11-bit proximity resolution, 100 ms measurement rate'
  i2cSet _apds9151Addr 3 (hexToInt '1D')
  comment 'Enable RGB and proximity sensing'
  i2cSet _apds9151Addr 0 7
  comment 'Wait at least 500 usecs for startup'
  waitMillis 1
  apds9151_setGainAndExposure '9' '25'
  comment 'Wait for first reading to complete'
  waitMillis 50
}

to '_apds9151_readData' {
  if (_apds9151Addr == 0) {'_apds9151_init'}
  local 'data' ('[data:newByteArray]' 14)
  comment 'Read all data:
  Proximity: 2 bytes, 11 bits
  IR, R, G, B: 3 bytes 24 bits each
Note: These values are updated
every 100 msecs. This method does
not wait for an update; it just returns
the last values read.'
  '[sensors:i2cWrite]' _apds9151Addr 8
  '[sensors:i2cRead]' _apds9151Addr data
  return data
}

to '_apds9151_twentyBits' byte1 byte2 byte3 {
  return ((((byte3 & 15) << 16) | (byte2 << 8)) | byte1)
}

to apds9151_IR {
  local 'data' ('_apds9151_readData')
  return ('_apds9151_twentyBits' (at 3 data) (at 4 data) (at 5 data))
}

to apds9151_color {
  return ('[misc:hsvColor]' (apds9151_hue) 100 80)
}

to apds9151_hue {
  local 'data' ('_apds9151_readData')
  local 'r' ('_apds9151_twentyBits' (at 12 data) (at 13 data) (at 14 data))
  local 'g' ('_apds9151_twentyBits' (at 6 data) (at 7 data) (at 8 data))
  local 'b' ('_apds9151_twentyBits' (at 9 data) (at 10 data) (at 11 data))
  local 'max' (maximum r g b)
  if (max == 0) {
    comment 'No light at all: r, g and b are all 0, so hue is undefined'
    return 0
  }
  r = ((255 * r) / max)
  g = ((255 * g) / max)
  b = ((255 * b) / max)
  local 'c' (((r << 16) | (g << 8)) | b)
  return ('[misc:hue]' c)
}

to apds9151_isClose {
  return ((apds9151_proximity) > 15)
}

to apds9151_lightLevel {
  comment 'Green level is close the human perceived brightness.
Level is a 20-bit value (0-1048575) to provide a wide dynamic range.'
  local 'data' ('_apds9151_readData')
  local 'rawGreen' ('_apds9151_twentyBits' (at 6 data) (at 7 data) (at 8 data))
  comment 'Normalize output for the current gain and exposure.'
  return ((18 * (rawGreen << apds9151_shift)) / apds9151_gain)
}

to apds9151_proximity {
  local 'data' ('_apds9151_readData')
  return ((((at 2 data) & 7) << 8) | (at 1 data))
}

to apds9151_seesColor c optionalThreshold {
  local 'threshold' (argOrDefault 2 15)
  local 'diff' (absoluteValue ((apds9151_hue) - ('[misc:hue]' c)))
  return (diff <= threshold)
}

to apds9151_setGainAndExposure gain exposure {
  '_apds9151_init'
  local 'i' (('[data:find]' (exposure + 0) ('[data:makeList]' 400 200 100 50 25)) - 1)
  if (i < 0) {
    comment 'Not found; default to third exposure option (100 msecs).'
    i = 3
  }
  comment 'Set exposure time. Update as fast as possible.'
  i2cSet _apds9151Addr 4 (i << 4)
  comment 'Record the shift required normalize for exposure. Bigger shifts for shorter exposures.'
  apds9151_shift = i
  comment 'Process the gain setting.'
  local 'gainOptions' ('[data:makeList]' 1 3 6 9 18)
  i = (('[data:find]' (gain + 0) gainOptions) - 1)
  if (i < 0) {
    comment 'Not found; default to third gain option (6)'
    i = 3
  }
  comment 'Set gain.'
  i2cSet _apds9151Addr 5 i
  comment 'Record current gain so we can normalize for it.'
  apds9151_gain = (at (i + 1) gainOptions)
}

script 749 305 {
to veml6040_seesColor c optionalThreshold {}
}

